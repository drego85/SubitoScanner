# ── e-mail notifications (optional) ──────────────────────────────────────────
# leave empty to disable e-mail
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SERVER=
# comma-separated list, e.g. Recipient <recipient@example.com>,Other <other@example.com>
SMTP_TOADDRS=

# ── slack notifications (optional) ───────────────────────────────────────────
# leave empty to disable slack
SLACK_WEBHOOK_URL=

# ── telegram notifications (recommended) ─────────────────────────────────────
# 1. open telegram, search @BotFather, send /newbot → copy the token it gives you
# 2. start a chat with your bot, then run:
#    curl https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#    look for "chat":{"id": ...} — that number is your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
