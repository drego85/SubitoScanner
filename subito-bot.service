[Unit]
Description=Subito Scanner Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# replace YOUR_USER and paths below before installing
User=YOUR_USER
WorkingDirectory=/path/to/SubitoScanner
ExecStart=/usr/bin/python3 /path/to/SubitoScanner/main.py --bot-service
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
